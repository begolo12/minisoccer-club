# =====================================================================
# Yang TIDAK boleh masuk repo.
#
# Aturan umum: hanya sumber yang dibutuhkan untuk membangun/menjalankan app
# yang di-commit. Semua hasil build, kredensial, dan artefak kerja lokal
# tinggal di mesin masing-masing.
#
# File yang WAJIB tetap ada di repo (jangan pernah diabaikan):
#   .env.example        template env; tanpa ini orang tidak tahu variabel apa
#                       yang harus diisi
#   pubspec.lock        versi paket terkunci, supaya build CI = lokal
#   package-lock.json   idem untuk dependensi Node
#   design/current/     baseline screenshot untuk dokumentasi
# =====================================================================

# ---------- Flutter / Dart ----------
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/
local.properties
flutter_*.log
*.dill

# ---------- Android ----------
android/local.properties
android/key.properties
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
*.jks
*.keystore

# ---------- Artefak rilis ----------
# APK/AAB dihasilkan CI dan diunggah ke GitHub Releases, bukan ke git:
# 60 MB per file akan membengkakkan riwayat selamanya.
*.apk
*.aab
*.ipa

# ---------- Node / Vercel ----------
node_modules/
.vercel/
.vercel
.env
.env.local
.env.production
.env.development
# Semua varian env lain (.env.staging, .env.test, .env.preview, …) juga
# rahasia. `.env.example` tetap terlacak lewat pengecualian di bawah.
.env.*
!.env.example

# ---------- Kredensial ----------
# Jangan pernah commit nilai rahasia. `.env.example` sengaja dikecualikan di
# bawah: itu template kosong, bukan kredensial.
*.pem
*.key
*.p12
*.pfx
*secret*
*credential*
# Pengecualian: PEMINDAI rahasia justru harus ikut repo. Pola di atas
# menyaring nama berkas yang mengandung "secret", dan itu ikut mengenai
# `scripts/secret-scan.mjs`.
!scripts/secret-scan.mjs

# ---------- Artefak kerja lokal ----------
# Hasil generate tes audit query (`flutter test test/queries_audit_test.dart`)
# berisi SQL + nilai contoh; tidak perlu ikut repo dan bisa dibuat ulang.
.audit/

# Screenshot kerja harness `design/mock/`. Baseline dokumentasi ada di
# `design/current/` (di-commit), folder ini hanya untuk tangkapan sementara.
.shots/

# Konfigurasi tooling lokal.
.claude/
design/mock/.broken
mock.log

# Screenshot pembanding milik produk lain.
design/ref/

# Tangkapan `scripts/_visual-sweep.mjs` (dan varian lokalnya). Dibuat ulang
# setiap kali dijalankan, ukurannya megabyte, dan tidak dibaca siapa pun.
design/sweep/
design/sweep-local/
design/sweep-prod/

# File kerja sementara (mis. connection string saat debug).
*.tmp
*.bak

# Keluaran terminal yang tertangkap saat menjalankan perintah manual.
# Pernah tidak sengaja ter-commit dan membuat repo berisi sampah.
ftest.txt
tmpout.txt
*.log

# Skrip debug sekali pakai (dbg-*.mjs) dan skrip sementara berawalan titik.
# Dibuat saat menelusuri satu masalah, dan tidak pernah bagian aplikasi.
dbg-*.mjs
.tmp-*

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Pengecualian ----------
# Template env harus tetap terlacak meskipun pola `.env*` di atas.
!.env.example

# Log build yang tertangkap ke berkas saat menjalankan perintah manual.
build.log

# Tangkapan keluaran perintah manual di akar repo (bukan bagian aplikasi).
# Semua .txt proyek ini ada di dalam subfolder, jadi akar aman diabaikan.
/*.txt
