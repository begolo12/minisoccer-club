# Skrip shell wajib LF: bash menolak `set -euo pipefail` yang berakhiran CR
# ("set: pipefail: invalid option name") dan build Vercel gagal sebelum mulai.
# Git di Windows kadang meng-checkout dengan CRLF, jadi aturan ini dipatok di
# sini, bukan mengandalkan `core.autocrlf` tiap mesin.
*.sh text eol=lf
scripts/*.mjs text eol=lf
api/*.js text eol=lf
api/*.mjs text eol=lf
db/*.sql text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Biner: jangan pernah dinormalisasi. Tanpa ini git bisa menganggap PNG/APK
# sebagai teks dan merusaknya saat checkout di mesin lain.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.apk binary
*.aab binary
*.zip binary
