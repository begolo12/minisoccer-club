<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Aplikasi ini selalu bertema gelap saat start (lihat `AppThemes.ink`),
         jadi layar pembuka memakai induk gelap di KEDUA berkas nilai.
         Sebelumnya berkas ini memakai `Theme.Light.NoTitleBar`: di HP mode
         terang, ikon jam/baterai digambar gelap di atas latar gelap sehingga
         tidak terlihat selama layar pembuka. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Tampil sampai Flutter menggambar frame pertama. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema jendela setelah proses mulai; juga latar di belakang UI Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
