<?xml version="1.0" encoding="utf-8"?>
<!-- Latar layar pembuka.
     Sebelumnya `@android:color/white`, padahal aplikasi ini bertema gelap
     (#080B09). Hasilnya di HP: layar putih menyala ~0,5 detik, lalu berkedip
     ke hitam — paling terasa di malam hari dan di HP yang peluncurannya lambat.
     Warna di sini HARUS sama dengan `AppThemes.ink` di `lib/ui/theme.dart`;
     kalau berbeda, kedipannya kembali. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <!-- Logo di tengah: sama dengan ikon aplikasi, supaya layar pembuka
         terlihat seperti bagian dari aplikasi, bukan layar kosong. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
