# Salin ke .env lalu isi. Jangan commit .env.

# Connection string Neon (dipakai api/sql.js & scripts/init-db.mjs)
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Kunci untuk endpoint /api/sql. Harus sama dengan --dart-define=APP_KEY saat build web.
APP_KEY=ganti-dengan-string-acak
