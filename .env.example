# Salin ke .env lalu isi. Jangan commit .env.

# Connection string Neon milik owner (dipakai api/auth.js & scripts/*.mjs).
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Connection string role terbatas untuk api/sql.js (dibuat oleh `npm run db:harden`).
# Role ini tidak bisa DDL dan tidak bisa baca kolom password.
DATABASE_URL_WEB=postgresql://app_web:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require

# Kunci penandatangan token sesi. Wajib di produksi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=ganti-dengan-string-acak-panjang
